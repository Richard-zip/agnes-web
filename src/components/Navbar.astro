---
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/70 bg-[#090d16]/85 backdrop-blur-xl transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-xl p-1">
      <div class="w-9 h-9 flex items-center justify-center shrink-0">
        <img src="/agnes-icon.png" alt="Logo de Agnes" class="w-8 h-8 object-contain transition-transform group-hover:scale-105" />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="text-xl font-extrabold tracking-tight text-white group-hover:text-indigo-400 transition-colors">Agnes</span>
        </div>
        <span class="text-[11px] text-slate-400 -mt-0.5 hidden sm:inline-block font-medium">Protocolos Académicos con IA</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 bg-slate-900/60 p-1.5 rounded-full border border-slate-800/80 shadow-inner">
      <a href="#inicio" class="px-3.5 py-1.5 text-xs font-medium text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-colors">Inicio</a>
      <a href="#garante" class="px-3.5 py-1.5 text-xs font-medium text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-colors flex items-center gap-1.5">
        <span>Garante 80%</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      </a>
      <a href="#caracteristicas" class="px-3.5 py-1.5 text-xs font-medium text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-colors">Características</a>
      <a href="#como-funciona" class="px-3.5 py-1.5 text-xs font-medium text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-colors">Cómo funciona</a>
      <a href="#descargar" class="px-3.5 py-1.5 text-xs font-medium text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-colors">Descargas</a>
      <a href="#faq" class="px-3.5 py-1.5 text-xs font-medium text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-colors">FAQ</a>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <a 
        href="https://github.com/Richard-zip/Agnes" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-slate-300 hover:text-white bg-slate-800/50 hover:bg-slate-800 border border-slate-700/60 rounded-xl transition-all duration-200"
        title="Ver repositorio de código abierto en GitHub"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>GitHub</span>
      </a>

      <a 
        href="#descargar" 
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-gradient-to-r from-indigo-500 via-indigo-600 to-blue-600 hover:from-indigo-600 hover:to-blue-700 rounded-xl shadow-lg shadow-indigo-500/25 transition-all duration-200 active:scale-95"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>Descargar App</span>
      </a>

      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="md:hidden p-2 rounded-xl text-slate-400 hover:text-white bg-slate-800/50 border border-slate-700/60 focus:outline-none"
        aria-label="Abrir menú de navegación"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800/80 bg-[#090d16]/95 backdrop-blur-2xl px-6 py-4 space-y-3">
    <a href="#inicio" class="block py-2 text-sm font-medium text-slate-300 hover:text-white border-b border-slate-800/40">Inicio</a>
    <a href="#garante" class="block py-2 text-sm font-medium text-emerald-400 border-b border-slate-800/40">Garante del Aprendizaje (80%)</a>
    <a href="#caracteristicas" class="block py-2 text-sm font-medium text-slate-300 hover:text-white border-b border-slate-800/40">Características</a>
    <a href="#como-funciona" class="block py-2 text-sm font-medium text-slate-300 hover:text-white border-b border-slate-800/40">Cómo funciona</a>
    <a href="#descargar" class="block py-2 text-sm font-medium text-slate-300 hover:text-white border-b border-slate-800/40">Descargas</a>
    <a href="#faq" class="block py-2 text-sm font-medium text-slate-300 hover:text-white border-b border-slate-800/40">Preguntas Frecuentes</a>
    <div class="pt-2 flex flex-col gap-2">
      <a 
        href="https://github.com/Richard-zip/Agnes" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center justify-center gap-2 py-2.5 text-xs font-semibold text-slate-300 bg-slate-800 rounded-xl"
      >
        Ver en GitHub
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }
</script>
